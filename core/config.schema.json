{
  "$defs": {
    "DetectorConfig": {
      "properties": {
        "anomaly_buffer_max": {
          "default": 10,
          "minimum": 1,
          "title": "Anomaly Buffer Max",
          "type": "integer"
        },
        "lstm_threshold_key": {
          "default": "robust_threshold",
          "title": "Lstm Threshold Key",
          "type": "string"
        }
      },
      "title": "DetectorConfig",
      "type": "object"
    },
    "ExplainerConfig": {
      "properties": {
        "llm_provider": {
          "$ref": "#/$defs/LlmProvider"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "target_model": {
          "title": "Target Model",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "runpod_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runpod Url"
        },
        "temperature": {
          "default": 0.1,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "audit_path": {
          "default": "logs/audit.jsonl",
          "title": "Audit Path",
          "type": "string"
        }
      },
      "required": [
        "llm_provider",
        "target_model"
      ],
      "title": "ExplainerConfig",
      "type": "object"
    },
    "KnowledgeConfig": {
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8080,
          "title": "Port",
          "type": "integer"
        },
        "default_page_size": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Default Page Size",
          "type": "integer"
        },
        "max_page_size": {
          "default": 100,
          "minimum": 1,
          "title": "Max Page Size",
          "type": "integer"
        }
      },
      "title": "KnowledgeConfig",
      "type": "object"
    },
    "LlmProvider": {
      "enum": [
        "openai",
        "ollama",
        "runpod"
      ],
      "title": "LlmProvider",
      "type": "string"
    },
    "MqttServiceConfig": {
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 1883,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "MqttServiceConfig",
      "type": "object"
    },
    "PostgresConfig": {
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 5432,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "default": "postgres",
          "title": "User",
          "type": "string"
        },
        "password": {
          "default": "postgres",
          "title": "Password",
          "type": "string"
        },
        "database": {
          "default": "muia",
          "title": "Database",
          "type": "string"
        }
      },
      "title": "PostgresConfig",
      "type": "object"
    },
    "RabbitMQServiceConfig": {
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 5672,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "default": "guest",
          "title": "User",
          "type": "string"
        },
        "password": {
          "default": "guest",
          "title": "Password",
          "type": "string"
        }
      },
      "title": "RabbitMQServiceConfig",
      "type": "object"
    },
    "RagConfig": {
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "llm_model": {
          "default": "gpt-4o-mini",
          "title": "Llm Model",
          "type": "string"
        },
        "embedding_model": {
          "default": "text-embedding-3-small",
          "title": "Embedding Model",
          "type": "string"
        },
        "temperature": {
          "default": 0.2,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_k": {
          "default": 5,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "title": "RagConfig",
      "type": "object"
    },
    "ServicesConfig": {
      "properties": {
        "mqtt": {
          "$ref": "#/$defs/MqttServiceConfig"
        },
        "rabbitmq": {
          "$ref": "#/$defs/RabbitMQServiceConfig"
        },
        "postgres": {
          "$ref": "#/$defs/PostgresConfig"
        }
      },
      "title": "ServicesConfig",
      "type": "object"
    },
    "SimulatorConfig": {
      "properties": {
        "csv_file_path": {
          "title": "Csv File Path",
          "type": "string"
        },
        "publish_delay": {
          "default": 2.0,
          "exclusiveMinimum": 0.0,
          "title": "Publish Delay",
          "type": "number"
        },
        "burst_delay": {
          "default": 0.1,
          "minimum": 0.0,
          "title": "Burst Delay",
          "type": "number"
        }
      },
      "required": [
        "csv_file_path"
      ],
      "title": "SimulatorConfig",
      "type": "object"
    }
  },
  "properties": {
    "log_level": {
      "default": "INFO",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "Log Level",
      "type": "string"
    },
    "log_levels": {
      "additionalProperties": {
        "enum": [
          "DEBUG",
          "INFO",
          "WARNING",
          "ERROR",
          "CRITICAL"
        ],
        "type": "string"
      },
      "title": "Log Levels",
      "type": "object"
    },
    "services": {
      "$ref": "#/$defs/ServicesConfig"
    },
    "simulator": {
      "$ref": "#/$defs/SimulatorConfig"
    },
    "detector": {
      "$ref": "#/$defs/DetectorConfig"
    },
    "explainer": {
      "$ref": "#/$defs/ExplainerConfig"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeConfig"
    },
    "rag": {
      "$ref": "#/$defs/RagConfig"
    }
  },
  "required": [
    "services",
    "simulator",
    "detector",
    "explainer"
  ],
  "title": "AppConfig",
  "type": "object"
}